{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source scraping the kthena-router /metrics endpoint",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["kthena", "kthena-router", "overview"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Data source",
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "allValue": ".*",
        "current": {"selected": true, "text": "All", "value": "$__all"},
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "definition": "label_values(kthena_router_requests_total, model)",
        "hide": 0,
        "includeAll": true,
        "label": "Model",
        "multi": true,
        "name": "model",
        "query": {"query": "label_values(kthena_router_requests_total, model)", "refId": "StandardVariableQuery"},
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {"selected": true, "text": "All", "value": "$__all"},
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "definition": "label_values(kthena_router_active_upstream_requests, backend_name)",
        "hide": 0,
        "includeAll": true,
        "label": "Backend",
        "multi": true,
        "name": "backend",
        "query": {"query": "label_values(kthena_router_active_upstream_requests, backend_name)", "refId": "StandardVariableQuery"},
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "",
  "title": "Kthena Router Overview",
  "uid": "kthena-router-overview",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Request rate",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Completed requests per second for the selected client models.",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "id": 1,
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(kthena_router_requests_total{model=~\"$model\"}[$__rate_interval]))", "legendFormat": "requests/s", "refId": "A"}
      ]
    },
    {
      "type": "stat",
      "title": "HTTP error ratio",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Fraction of completed requests returning a 4xx or 5xx status. Rate-limit rejections are detailed below.",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "id": 2,
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.01}, {"color": "red", "value": 0.05}]}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "(sum(rate(kthena_router_requests_total{model=~\"$model\", status_code=~\"[45]..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(kthena_router_requests_total{model=~\"$model\"}[$__rate_interval])), 0.000000001)", "legendFormat": "errors", "refId": "A"}
      ]
    },
    {
      "type": "stat",
      "title": "Request latency p99",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "99th-percentile end-to-end request latency across the selected client models.",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "id": 3,
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "histogram_quantile(0.99, sum by (le) (rate(kthena_router_request_duration_seconds_bucket{model=~\"$model\"}[$__rate_interval])))", "legendFormat": "p99", "refId": "A"}
      ]
    },
    {
      "type": "stat",
      "title": "Active client requests",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Current client-to-router requests across all scraped router replicas for the selected models.",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "id": 4,
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(kthena_router_active_downstream_requests{model=~\"$model\"})", "legendFormat": "active", "refId": "A"}
      ]
    },
    {
      "type": "row",
      "title": "Traffic and latency",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "id": 101,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Request rate by model and status",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Completed request rate split by client model and HTTP status code.",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 6},
      "id": 5,
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (model, status_code) (rate(kthena_router_requests_total{model=~\"$model\"}[$__rate_interval]))", "legendFormat": "{{model}} HTTP {{status_code}}", "refId": "A"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Error rate by type",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "4xx and 5xx request rate split by the router's stable error classification and response status.",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 6},
      "id": 6,
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (error_type, status_code) (rate(kthena_router_requests_total{model=~\"$model\", status_code=~\"[45]..\"}[$__rate_interval]))", "legendFormat": "{{error_type}} HTTP {{status_code}}", "refId": "A"}
      ]
    },
    {
      "type": "timeseries",
      "title": "End-to-end request latency",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Latency quantiles aggregated across the selected client models and destinations.",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 6},
      "id": 7,
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "histogram_quantile(0.5, sum by (le) (rate(kthena_router_request_duration_seconds_bucket{model=~\"$model\"}[$__rate_interval])))", "legendFormat": "p50", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "histogram_quantile(0.9, sum by (le) (rate(kthena_router_request_duration_seconds_bucket{model=~\"$model\"}[$__rate_interval])))", "legendFormat": "p90", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "histogram_quantile(0.99, sum by (le) (rate(kthena_router_request_duration_seconds_bucket{model=~\"$model\"}[$__rate_interval])))", "legendFormat": "p99", "refId": "C"}
      ]
    },
    {
      "type": "row",
      "title": "Inference phases and tokens",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14},
      "id": 102,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Prefill and decode latency",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Phase latency for prefill/decode-disaggregated requests. No series are shown until that request path is exercised.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "id": 8,
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "histogram_quantile(0.5, sum by (le) (rate(kthena_router_request_prefill_duration_seconds_bucket{model=~\"$model\"}[$__rate_interval])))", "legendFormat": "prefill p50", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "histogram_quantile(0.9, sum by (le) (rate(kthena_router_request_prefill_duration_seconds_bucket{model=~\"$model\"}[$__rate_interval])))", "legendFormat": "prefill p90", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "histogram_quantile(0.99, sum by (le) (rate(kthena_router_request_prefill_duration_seconds_bucket{model=~\"$model\"}[$__rate_interval])))", "legendFormat": "prefill p99", "refId": "C"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "histogram_quantile(0.5, sum by (le) (rate(kthena_router_request_decode_duration_seconds_bucket{model=~\"$model\"}[$__rate_interval])))", "legendFormat": "decode p50", "refId": "D"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "histogram_quantile(0.9, sum by (le) (rate(kthena_router_request_decode_duration_seconds_bucket{model=~\"$model\"}[$__rate_interval])))", "legendFormat": "decode p90", "refId": "E"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "histogram_quantile(0.99, sum by (le) (rate(kthena_router_request_decode_duration_seconds_bucket{model=~\"$model\"}[$__rate_interval])))", "legendFormat": "decode p99", "refId": "F"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Token throughput",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Input tokens calculated by the router and output tokens reported by upstream responses, per second.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
      "id": 9,
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (token_type) (rate(kthena_router_tokens_total{model=~\"$model\"}[$__rate_interval]))", "legendFormat": "{{token_type}} tokens/s", "refId": "A"}
      ]
    },
    {
      "type": "row",
      "title": "Concurrency and queues",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23},
      "id": 103,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Active client requests",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Current client-to-router requests summed across router replicas and split by client model.",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 24},
      "id": 10,
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (model) (kthena_router_active_downstream_requests{model=~\"$model\"})", "legendFormat": "{{model}}", "refId": "A"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Backend load — active upstream requests",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Current router-to-backend requests. This is a concurrency/load signal, not a saturation ratio: the router does not expose backend capacity or utilization. The client-model filter does not apply because this metric has destination labels instead.",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 24},
      "id": 11,
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (backend_type, backend_name, upstream_model) (kthena_router_active_upstream_requests{backend_name=~\"$backend\"})", "legendFormat": "{{backend_type}} {{backend_name}} ({{upstream_model}})", "refId": "A"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Queued requests",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Pending requests in the fairness and session-boost queues. A series appears only when its scheduling feature is enabled and exercised.",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 24},
      "id": 12,
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (model) (kthena_router_fairness_queue_size{model=~\"$model\", user_id=\"_all\"})", "legendFormat": "fairness {{model}}", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (model) (kthena_router_session_boost_queue_size{model=~\"$model\"})", "legendFormat": "session boost {{model}}", "refId": "B"}
      ]
    },
    {
      "type": "row",
      "title": "Admission and routing failures",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 32},
      "id": 104,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Rate-limit rejections",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Requests rejected by configured request, input-token, or output-token rate limits.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 33},
      "id": 13,
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (model, limit_type) (rate(kthena_router_rate_limit_exceeded_total{model=~\"$model\"}[$__rate_interval]))", "legendFormat": "{{model}} {{limit_type}}", "refId": "A"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Routing and upstream failures",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Failures other than prompt validation and rate limiting, covering route selection, scheduling, backend discovery, proxying, and upstream responses.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 33},
      "id": 14,
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (error_type, backend_type, backend_name) (rate(kthena_router_requests_total{model=~\"$model\", error_type!~\"successful_request|prompt_parsing|rate_limit\"}[$__rate_interval]))", "legendFormat": "{{error_type}} — {{backend_type}} {{backend_name}}", "refId": "A"}
      ]
    }
  ]
}
